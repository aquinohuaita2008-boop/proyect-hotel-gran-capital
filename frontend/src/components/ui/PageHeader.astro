---
const { title, description, action }=Astro.props;
---
<div class="mb-7 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><h1 class="font-display text-3xl text-ink">{title}</h1>{description&&<p class="mt-1 text-sm text-slate-500">{description}</p>}</div>{action&&<slot name="action" />}</div>

