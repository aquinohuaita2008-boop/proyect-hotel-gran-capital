---
import DashboardLayout from '@/layouts/DashboardLayout.astro';import Guard from '@/components/layout/Guard.astro';import PageHeader from '@/components/ui/PageHeader.astro';import Button from '@/components/ui/Button.astro';
---
<DashboardLayout title="Servicios adicionales"><Guard/><PageHeader title="Servicios adicionales" description="Catálogo y solicitudes para una estancia especial"><Button slot="action" id="new-service">Nuevo servicio</Button></PageHeader><div id="service-feedback" class="mb-4 hidden rounded-lg p-3 text-sm"></div><div id="service-list" class="grid gap-5 md:grid-cols-2 xl:grid-cols-3"></div><section class="mt-10"><h2 class="mb-4 font-display text-2xl text-ink">Solicitudes de huéspedes</h2><div class="surface overflow-x-auto"><table class="w-full min-w-[700px] text-left text-sm"><thead class="border-b bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="p-4">Servicio</th><th class="p-4">Reserva</th><th class="p-4">Cliente</th><th class="p-4">Cantidad</th><th class="p-4">Estado</th></tr></thead><tbody id="request-list"></tbody></table></div></section><div id="service-modal" class="fixed inset-0 z-20 hidden items-center justify-center bg-ink/60 p-5"><form id="service-form" class="surface w-full max-w-md p-6"><h2 class="font-display text-2xl text-ink">Nuevo servicio</h2><label class="mt-5 block text-sm font-bold">Nombre<input name="nombre" class="field" required></label><label class="mt-4 block text-sm font-bold">Descripción<textarea name="descripcion" class="field" required></textarea></label><label class="mt-4 block text-sm font-bold">Precio<input name="precio" type="number" min="0" step=".01" class="field" required></label><label class="mt-4 flex items-center gap-2 text-sm font-bold"><input name="disponible" type="checkbox" checked> Disponible</label><div class="mt-5 flex gap-3"><button type="button" id="close-service" class="w-1/2 rounded-lg bg-mist py-3 font-bold text-ocean">Cancelar</button><button class="w-1/2 rounded-lg bg-ocean py-3 font-bold text-white">Guardar</button></div></form></div><script src="../../scripts/services.ts"></script></DashboardLayout>

