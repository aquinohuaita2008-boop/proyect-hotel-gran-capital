---
import MainLayout from '@/layouts/MainLayout.astro';
---
<MainLayout title="Consultar disponibilidad · Hotel Gran Capital">
  <header class="flex items-center justify-between bg-ink px-6 py-5 text-white md:px-12"><a href="/" class="font-display text-xl tracking-wide text-gold">HOTEL GRAN CAPITAL</a><a href="/login" class="rounded-lg border border-white/40 px-4 py-2 text-sm font-bold hover:bg-white/10">Ingresar</a></header>
  <main class="mx-auto min-h-screen max-w-6xl px-6 py-14 md:px-10">
    <p class="text-sm font-bold uppercase tracking-widest text-gold">Reservas</p>
    <h1 class="mt-3 font-display text-5xl text-ink">Consulta la disponibilidad</h1>
    <p class="mt-3 max-w-2xl text-slate-600">Selecciona tus fechas y la cantidad de huéspedes para consultar las habitaciones disponibles.</p>
    <form id="availability-form" class="surface mt-8 grid gap-4 p-6 md:grid-cols-4 md:items-end"><label class="text-sm font-bold text-slate-600">Entrada<input name="fechaEntrada" type="date" class="field" required /></label><label class="text-sm font-bold text-slate-600">Salida<input name="fechaSalida" type="date" class="field" required /></label><label class="text-sm font-bold text-slate-600">Huéspedes<input name="huespedes" type="number" min="1" value="1" class="field" required /></label><button class="rounded-lg bg-ocean px-4 py-3 font-bold text-white hover:bg-ink">Buscar habitaciones</button></form>
    <div id="availability-feedback" class="mt-5"></div><div id="availability-list" class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3"></div>
  </main>
  <script src="../scripts/availability.ts"></script>
</MainLayout>
