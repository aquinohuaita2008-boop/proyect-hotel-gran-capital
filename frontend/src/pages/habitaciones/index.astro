---
import DashboardLayout from '@/layouts/DashboardLayout.astro';import Guard from '@/components/layout/Guard.astro';import PageHeader from '@/components/ui/PageHeader.astro';import Button from '@/components/ui/Button.astro';import Status from '@/components/ui/Status.astro';
---
<DashboardLayout title="Habitaciones"><Guard/><PageHeader title="Habitaciones" description="Consulta el inventario y disponibilidad del hotel"><Button slot="action" id="new-room">Nueva habitación</Button></PageHeader><div id="feedback" class="mb-4 hidden rounded-lg p-3 text-sm"></div><div class="mb-5 flex flex-wrap gap-3"><input id="filter-type" class="rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm" placeholder="Filtrar por tipo"/><select id="filter-status" class="rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm"><option value="">Todos los estados</option><option>DISPONIBLE</option><option>RESERVADA</option><option>OCUPADA</option><option>LIMPIEZA</option><option>MANTENIMIENTO</option></select><Button id="apply-filter" variant="secondary">Filtrar</Button></div><div id="room-list" class="grid gap-5 md:grid-cols-2 xl:grid-cols-3"><div class="surface h-64 animate-pulse"></div></div><div id="room-modal" class="fixed inset-0 z-20 hidden items-center justify-center bg-ink/60 p-5"><form id="room-form" class="surface max-h-[90vh] w-full max-w-lg overflow-auto p-6"><div class="flex justify-between"><h2 class="font-display text-2xl text-ink">Nueva habitación</h2><button type="button" id="close-room" class="text-2xl text-slate-400">×</button></div><div class="mt-5 grid gap-4 sm:grid-cols-2"><label class="text-sm font-bold">Número<input name="numero" type="number" class="field" required></label><label class="text-sm font-bold">Tipo<input name="tipo" class="field" required></label><label class="text-sm font-bold">Capacidad<input name="capacidad" type="number" class="field" min="1" required></label><label class="text-sm font-bold">Precio/noche<input name="precio" type="number" min="0" step=".01" class="field" required></label><label class="text-sm font-bold sm:col-span-2">Estado<select name="estado" class="field"><option>DISPONIBLE</option><option>RESERVADA</option><option>OCUPADA</option><option>LIMPIEZA</option><option>MANTENIMIENTO</option></select></label></div><button class="mt-5 w-full rounded-lg bg-ocean px-4 py-3 font-bold text-white">Guardar</button></form></div><script src="../../scripts/rooms.ts"></script></DashboardLayout>

