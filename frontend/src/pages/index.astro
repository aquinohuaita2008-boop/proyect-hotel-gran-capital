---
import MainLayout from '@/layouts/MainLayout.astro';
import { hotelInfo } from '@/config/hotel';

const whatsappUrl = hotelInfo.whatsapp.replace('+', 'https://wa.me/');
const roomSummary = [
  { title: 'Habitaciones matrimoniales', text: 'Espacios pensados para descansar con comodidad.', image: 'https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=1000&q=85', alt: 'Habitación matrimonial' },
  { title: 'Habitaciones dobles', text: 'Una opción práctica para compartir tu estadía.', image: 'https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=1000&q=85', alt: 'Habitación doble' },
  { title: 'Habitaciones simples', text: 'Confort y tranquilidad para viajes personales o de trabajo.', image: 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1000&q=85', alt: 'Habitación simple' },
];
---
<MainLayout title="Hotel Gran Capital · Camiri">
  <div class="bg-[#f7f5f0] text-ink">
    <div class="hidden border-b border-[#eadfce] bg-[#fbfaf7] px-6 py-2 text-[11px] text-slate-500 md:block"><div class="mx-auto flex max-w-7xl justify-between"><span>Hotel Gran Capital · Camiri, Santa Cruz, Bolivia</span><span>Reservas y consultas: {hotelInfo.phone} · WhatsApp disponible</span></div></div>
    <header class="sticky top-0 z-30 border-b border-white/20 bg-[#f7f5f0]/95 px-5 py-4 backdrop-blur md:px-10"><div class="mx-auto flex max-w-7xl items-center justify-between gap-6"><a href="/" class="flex items-center gap-3"><span class="flex h-9 w-9 items-center justify-center rounded-full bg-ink text-sm font-bold text-gold">GC</span><span><strong class="block font-display text-lg leading-none text-ink">Hotel Gran Capital</strong><small class="text-[10px] uppercase tracking-[.2em] text-gold">Camiri · Bolivia</small></span></a><nav class="hidden items-center gap-6 text-[11px] font-bold uppercase tracking-wider text-slate-600 lg:flex"><a href="#habitaciones" class="hover:text-ocean">Habitaciones</a><a href="#servicios" class="hover:text-ocean">Servicios</a><a href="#eventos" class="hover:text-ocean">Eventos</a><a href="#ubicacion" class="hover:text-ocean">Ubicación</a><a href="#creadores" class="hover:text-ocean">Proyecto</a></nav><div class="flex items-center gap-2"><a href="/login" class="hidden rounded-lg border border-ink/20 px-4 py-2 text-xs font-bold text-ink hover:bg-white sm:block">Ingresar</a><a href="/disponibilidad" class="rounded-lg bg-[#8d351c] px-4 py-2 text-xs font-bold text-white shadow-sm hover:bg-ink">Consultar disponibilidad</a></div></div></header>

    <main>
      <section class="relative overflow-hidden bg-ink px-5 py-16 text-white md:px-10 md:py-24"><div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(16,40,63,.96),rgba(16,40,63,.55)),url('https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?auto=format&fit=crop&w=2200&q=90')] bg-cover bg-center"></div><div class="relative mx-auto grid max-w-7xl items-center gap-10 lg:grid-cols-[1.05fr_.95fr]"><div><p class="mb-5 text-[11px] font-bold uppercase tracking-[.28em] text-[#e4bd79]">Hospitalidad en Camiri · Santa Cruz</p><h1 class="max-w-3xl font-display text-5xl leading-[.98] md:text-7xl">Una estadía cómoda para disfrutar y reunirse.</h1><p class="mt-6 max-w-xl text-base leading-relaxed text-slate-200 md:text-lg">Conoce el Hotel Gran Capital: habitaciones, áreas recreativas y espacios para eventos en una ubicación privilegiada de Camiri.</p><div class="mt-8 flex flex-wrap gap-3"><a href="/disponibilidad" class="rounded-lg bg-[#c99b52] px-5 py-3 text-sm font-bold text-ink hover:bg-white">Buscar disponibilidad</a><a href={whatsappUrl} class="rounded-lg border border-white/40 px-5 py-3 text-sm font-bold text-white hover:bg-white/10">Consultar por WhatsApp</a></div></div><div class="relative mx-auto w-full max-w-xl"><div class="overflow-hidden rounded-2xl border border-white/20 bg-white/10 p-2 shadow-2xl backdrop-blur-sm"><img src="https://images.unsplash.com/photo-1576013551627-0cc20b96c2a7?auto=format&fit=crop&w=1100&q=90" alt="Piscina y área recreativa" class="h-72 w-full rounded-xl object-cover md:h-96"/><div class="flex items-center justify-between gap-4 bg-white px-4 py-3 text-ink"><div><p class="text-[10px] font-bold uppercase tracking-widest text-gold">Hotel Gran Capital</p><p class="mt-1 font-display text-xl">Descanso en Camiri</p></div><a href="#ubicacion" class="rounded-full bg-mist px-3 py-2 text-xs font-bold text-ocean">Ver ubicación</a></div></div></div></div></section>

      <section class="relative z-10 mx-auto -mt-8 max-w-6xl px-5 md:px-10"><div class="surface grid gap-4 border-white bg-white/95 p-5 shadow-xl md:grid-cols-[1fr_1fr_.8fr_auto] md:items-end"><label class="text-xs font-bold uppercase tracking-wider text-slate-500">Fecha de entrada<input type="date" class="field" aria-label="Fecha de entrada" /></label><label class="text-xs font-bold uppercase tracking-wider text-slate-500">Fecha de salida<input type="date" class="field" aria-label="Fecha de salida" /></label><label class="text-xs font-bold uppercase tracking-wider text-slate-500">Huéspedes<select class="field" aria-label="Cantidad de huéspedes"><option>1 huésped</option><option>2 huéspedes</option><option>3 huéspedes</option><option>4 huéspedes</option></select></label><a href="/disponibilidad" class="rounded-lg bg-[#8d351c] px-5 py-3 text-center text-sm font-bold text-white hover:bg-ink">Consultar</a></div></section>

      <section class="mx-auto max-w-7xl px-5 py-20 md:px-10"><div class="grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-end"><div><p class="text-[11px] font-bold uppercase tracking-[.25em] text-gold">Una experiencia cercana</p><h2 class="mt-3 max-w-xl font-display text-4xl leading-tight md:text-5xl">Comodidad real en el corazón de Camiri.</h2></div><p class="max-w-2xl text-sm leading-7 text-slate-600">Estamos ubicados en la Avenida Petrolera, frente a la portería de YPFB. Nuestra propuesta combina hospedaje, recreación y espacios para compartir en el Chaco boliviano.</p></div><div class="mt-10 grid gap-4 md:grid-cols-3"><div class="rounded-xl bg-[#e9dfd0] p-5"><p class="font-display text-3xl text-ink">31</p><p class="mt-2 text-xs font-bold uppercase tracking-wider text-slate-600">Habitaciones</p><p class="mt-2 text-sm text-slate-600">Matrimoniales, dobles y simples.</p></div><div class="rounded-xl bg-[#d9ebe6] p-5"><p class="font-display text-3xl text-ink">46</p><p class="mt-2 text-xs font-bold uppercase tracking-wider text-slate-600">Personas</p><p class="mt-2 text-sm text-slate-600">Capacidad publicada del hotel.</p></div><div class="rounded-xl bg-[#eee7d6] p-5"><p class="font-display text-3xl text-ink">24/7</p><p class="mt-2 text-xs font-bold uppercase tracking-wider text-slate-600">Tu consulta</p><p class="mt-2 text-sm text-slate-600">Comunícate directamente con el hotel.</p></div></div></section>

      <section id="habitaciones" class="bg-[#eee9e0] px-5 py-20 md:px-10"><div class="mx-auto max-w-7xl"><div class="flex flex-wrap items-end justify-between gap-5"><div><p class="text-[11px] font-bold uppercase tracking-[.25em] text-gold">Descanso pensado para ti</p><h2 class="mt-3 font-display text-4xl md:text-5xl">Habitaciones</h2></div><a href="/disponibilidad" class="rounded-lg border border-ink/20 bg-white px-4 py-2 text-xs font-bold text-ink hover:bg-ink hover:text-white">Consultar habitaciones</a></div><div class="mt-10 grid gap-5 md:grid-cols-3">{roomSummary.map((room, index)=><article class={`overflow-hidden rounded-xl bg-white shadow-sm ${index===1?'md:translate-y-8':''}`}><img src={room.image} alt={room.alt} class="h-64 w-full object-cover"/><div class="p-5"><p class="text-[10px] font-bold uppercase tracking-widest text-gold">Hotel Gran Capital</p><h3 class="mt-2 font-display text-2xl">{room.title}</h3><p class="mt-2 text-sm leading-6 text-slate-500">{room.text}</p><a href="/disponibilidad" class="mt-5 inline-block text-xs font-bold text-ocean">Ver disponibilidad →</a></div></article>)}</div></div></section>

      <section id="servicios" class="mx-auto max-w-7xl px-5 py-20 md:px-10"><div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]"><div><p class="text-[11px] font-bold uppercase tracking-[.25em] text-gold">Todo en un mismo lugar</p><h2 class="mt-3 font-display text-4xl md:text-5xl">Servicios para disfrutar tu estadía.</h2><p class="mt-5 max-w-md text-sm leading-7 text-slate-600">Espacios y servicios publicados para descansar, compartir y organizar tus actividades en Camiri.</p></div><div class="grid grid-cols-2 gap-3 sm:grid-cols-3">{hotelInfo.amenities.map((item)=><div class="rounded-xl border border-[#e7dfd2] bg-white p-4"><span class="text-lg text-[#8d351c]">✦</span><p class="mt-3 text-sm font-bold text-ink">{item}</p></div>)}</div></div></section>

      <section id="eventos" class="bg-white px-5 py-20 md:px-10"><div class="mx-auto max-w-7xl"><div class="text-center"><p class="text-[11px] font-bold uppercase tracking-[.25em] text-gold">Encuentros y celebraciones</p><h2 class="mt-3 font-display text-4xl md:text-5xl">Eventos y reuniones</h2><p class="mx-auto mt-4 max-w-2xl text-sm leading-6 text-slate-500">Ambientes para tus ocasiones especiales, reuniones y encuentros en el Hotel Gran Capital.</p></div><div class="mt-10 grid gap-6 md:grid-cols-2"><article class="group overflow-hidden rounded-xl bg-[#f7f5f0]"><img src="https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&w=1200&q=90" alt="Salón de eventos" class="h-72 w-full object-cover transition duration-500 group-hover:scale-105"/><div class="p-6"><p class="text-[10px] font-bold uppercase tracking-widest text-gold">Espacios del hotel</p><h3 class="mt-2 font-display text-3xl">Salón de eventos</h3><p class="mt-3 text-sm leading-6 text-slate-600">Un espacio para celebrar, reunirse y crear momentos especiales.</p></div></article><article class="group overflow-hidden rounded-xl bg-[#f7f5f0]"><img src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1200&q=90" alt="Sala de reuniones" class="h-72 w-full object-cover transition duration-500 group-hover:scale-105"/><div class="p-6"><p class="text-[10px] font-bold uppercase tracking-widest text-gold">Reuniones</p><h3 class="mt-2 font-display text-3xl">Sala de reuniones</h3><p class="mt-3 text-sm leading-6 text-slate-600">Un ambiente para conversar, trabajar y organizar tus actividades.</p></div></article></div></div></section>

      <section id="ubicacion" class="mx-auto max-w-7xl px-5 py-20 md:px-10"><div class="grid overflow-hidden rounded-2xl bg-ink text-white lg:grid-cols-[.85fr_1.15fr]"><div class="p-8 md:p-12"><p class="text-[11px] font-bold uppercase tracking-[.25em] text-[#e4bd79]">Encuéntranos en Camiri</p><h2 class="mt-4 font-display text-4xl">Ubicación y contacto</h2><p class="mt-5 text-sm leading-7 text-slate-300">{hotelInfo.address}.<br />{hotelInfo.city}, {hotelInfo.department}, {hotelInfo.country}</p><div class="mt-8 space-y-3 text-sm"><a href={`tel:${hotelInfo.phone}`} class="block rounded-lg bg-white/10 px-4 py-3 hover:bg-white/20">Teléfono: {hotelInfo.phone}</a><a href={whatsappUrl} class="block rounded-lg bg-white/10 px-4 py-3 hover:bg-white/20">WhatsApp: {hotelInfo.whatsapp}</a></div><a href={hotelInfo.maps} target="_blank" class="mt-8 inline-block rounded-lg bg-[#c99b52] px-5 py-3 text-sm font-bold text-ink hover:bg-white">Abrir ubicación</a></div><iframe title="Mapa del Hotel Gran Capital" class="min-h-[360px] w-full border-0 grayscale-[.15]" loading="lazy" src={`https://www.google.com/maps?q=${hotelInfo.coordinates.latitude},${hotelInfo.coordinates.longitude}&output=embed`}></iframe></div></section>

      <section id="creadores" class="bg-[#d9ebe6] px-5 py-20 md:px-10"><div class="mx-auto flex max-w-6xl flex-col items-center gap-8 text-center md:flex-row md:text-left"><div class="flex h-32 w-32 shrink-0 items-center justify-center rounded-full bg-white p-4 shadow-lg"><img src="/images/escudo-infosis.png" alt="Escudo de Informática y Sistemas FICH-UAGRM" class="h-full w-full object-contain" /></div><div><p class="text-[11px] font-bold uppercase tracking-[.25em] text-ocean">Proyecto académico y tecnológico</p><h2 class="mt-3 font-display text-4xl">Creado por estudiantes de Informática y Sistemas</h2><p class="mt-4 max-w-3xl text-sm leading-7 text-slate-700">Este sistema fue desarrollado por estudiantes de las carreras de Informática y Sistemas de la Facultad Integral del Chaco — UAGRM, en el marco del <strong>INFOSIS BUILD FEST 2026</strong>.</p><div class="mt-6 flex flex-wrap justify-center gap-3 md:justify-start"><a href="https://infosist.org" target="_blank" rel="noreferrer" class="rounded-lg bg-ink px-5 py-3 text-sm font-bold text-white hover:bg-ocean">Conocer INFOSIS</a><a href="https://infosist.org#eventos" target="_blank" rel="noreferrer" class="rounded-lg border border-ink/30 px-5 py-3 text-sm font-bold text-ink hover:bg-white">Ver el evento</a></div></div></div></section>
    </main>

    <footer class="border-t border-[#e4dacb] bg-[#f7f5f0] px-5 py-12 md:px-10"><div class="mx-auto grid max-w-7xl gap-8 text-sm text-slate-600 md:grid-cols-4"><div><p class="font-display text-xl text-ink">Hotel Gran Capital</p><p class="mt-3 leading-6">Hospedaje, recreación y encuentros en Camiri.</p></div><div><p class="font-bold text-ink">Información</p><p class="mt-3 leading-6">{hotelInfo.address}<br />{hotelInfo.city}, {hotelInfo.department}</p></div><div><p class="font-bold text-ink">Contacto</p><p class="mt-3 leading-6">{hotelInfo.phone}<br />{hotelInfo.whatsapp}</p></div><div><p class="font-bold text-ink">Enlaces</p><div class="mt-3 space-y-2"><a href="/disponibilidad" class="block hover:text-ocean">Disponibilidad</a><a href={hotelInfo.facebook} target="_blank" class="block hover:text-ocean">Facebook</a><a href="/login" class="block hover:text-ocean">Ingresar</a></div></div></div><div class="mx-auto mt-10 max-w-7xl border-t border-[#e4dacb] pt-5 text-xs text-slate-500">© {new Date().getFullYear()} Hotel Gran Capital · Camiri, Santa Cruz, Bolivia</div></footer>
  </div>
</MainLayout>
