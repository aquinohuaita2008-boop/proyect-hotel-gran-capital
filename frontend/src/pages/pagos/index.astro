---
import DashboardLayout from '@/layouts/DashboardLayout.astro';import Guard from '@/components/layout/Guard.astro';import PageHeader from '@/components/ui/PageHeader.astro';import Button from '@/components/ui/Button.astro';
---
<DashboardLayout title="Pagos"><Guard/><PageHeader title="Pagos" description="Consulta y registra los pagos asociados a reservas"><Button slot="action" id="new-payment">Registrar pago</Button></PageHeader><div id="payment-feedback" class="mb-4 hidden rounded-lg p-3 text-sm"></div><div class="surface overflow-x-auto"><table class="w-full min-w-[700px] text-left text-sm"><thead class="border-b bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="p-4">Reserva</th><th class="p-4">Monto</th><th class="p-4">Método</th><th class="p-4">Estado</th><th class="p-4">Fecha</th></tr></thead><tbody id="payment-list"></tbody></table></div><div id="payment-modal" class="fixed inset-0 z-20 hidden items-center justify-center bg-ink/60 p-5"><form id="payment-form" class="surface w-full max-w-md p-6"><h2 class="font-display text-2xl text-ink">Registrar pago</h2><label class="mt-5 block text-sm font-bold">Reserva ID<input name="reservaId" type="number" class="field" required></label><label class="mt-4 block text-sm font-bold">Monto<input name="monto" type="number" min="0.01" step=".01" class="field" required></label><label class="mt-4 block text-sm font-bold">Método<select name="metodoPago" class="field"><option>EFECTIVO</option><option>TARJETA</option><option>TRANSFERENCIA</option></select></label><label class="mt-4 block text-sm font-bold">Estado<select name="estado" class="field"><option>PENDIENTE</option><option>PARCIAL</option><option>PAGADO</option><option>REEMBOLSADO</option></select></label><div class="mt-5 flex gap-3"><button type="button" id="close-payment" class="w-1/2 rounded-lg bg-mist py-3 font-bold text-ocean">Cancelar</button><button class="w-1/2 rounded-lg bg-ocean py-3 font-bold text-white">Guardar</button></div></form></div><script src="../../scripts/payments.ts"></script></DashboardLayout>

