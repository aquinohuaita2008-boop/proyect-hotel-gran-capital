---
import DashboardLayout from '@/layouts/DashboardLayout.astro';import Guard from '@/components/layout/Guard.astro';import PageHeader from '@/components/ui/PageHeader.astro';import Button from '@/components/ui/Button.astro';
---
<DashboardLayout title="Reservas"><Guard/><PageHeader title="Reservas" description="Gestiona estancias, estados y operaciones de huéspedes"><Button slot="action" id="new-reservation">Nueva reserva</Button></PageHeader><div id="reservation-feedback" class="mb-4 hidden rounded-lg p-3 text-sm"></div><div class="surface overflow-x-auto"><table class="w-full min-w-[900px] text-left text-sm"><thead class="border-b bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="p-4">Código</th><th class="p-4">Habitación</th><th class="p-4">Fechas</th><th class="p-4">Huéspedes</th><th class="p-4">Estado</th><th class="p-4">Acciones</th></tr></thead><tbody id="reservation-list"></tbody></table></div><div id="reservation-modal" class="fixed inset-0 z-20 hidden items-center justify-center bg-ink/60 p-5"><form id="reservation-form" class="surface w-full max-w-lg p-6"><h2 class="font-display text-2xl text-ink">Nueva reserva</h2><div class="mt-5 grid gap-4"><label class="text-sm font-bold">Cliente ID <span class="font-normal text-slate-400">(solo personal)</span><input name="clienteId" type="number" class="field" /></label><label class="text-sm font-bold">Habitación ID<input name="habitacionId" type="number" class="field" required /></label><div class="grid gap-4 sm:grid-cols-2"><label class="text-sm font-bold">Entrada<input name="fechaEntrada" type="date" class="field" required /></label><label class="text-sm font-bold">Salida<input name="fechaSalida" type="date" class="field" required /></label></div><label class="text-sm font-bold">Huéspedes<input name="cantidadHuespedes" type="number" min="1" value="1" class="field" required /></label></div><div class="mt-5 flex gap-3"><button type="button" id="close-reservation" class="w-1/2 rounded-lg bg-mist py-3 font-bold text-ocean">Cancelar</button><button class="w-1/2 rounded-lg bg-ocean py-3 font-bold text-white">Guardar</button></div></form></div><script src="../../scripts/reservations.ts"></script></DashboardLayout>

