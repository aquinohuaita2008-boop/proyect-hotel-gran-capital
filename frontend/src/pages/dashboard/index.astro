---
import DashboardLayout from '@/layouts/DashboardLayout.astro';import Guard from '@/components/layout/Guard.astro';import PageHeader from '@/components/ui/PageHeader.astro';
---
<DashboardLayout title="Dashboard"><Guard/><PageHeader title="Dashboard" description="Resumen operativo del Hotel Gran Capital"/><div id="dash-error"></div><div id="stats" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><div class="surface h-28 animate-pulse bg-slate-100"></div><div class="surface h-28 animate-pulse bg-slate-100"></div><div class="surface h-28 animate-pulse bg-slate-100"></div><div class="surface h-28 animate-pulse bg-slate-100"></div></div><section class="mt-8 grid gap-6 lg:grid-cols-2"><div class="surface p-6"><h2 class="font-display text-2xl text-ink">Operación de hoy</h2><div id="today" class="mt-5 grid grid-cols-2 gap-3"></div></div><div class="surface p-6"><h2 class="font-display text-2xl text-ink">Accesos rápidos</h2><div class="mt-5 grid grid-cols-2 gap-3"><a href="/reservas" class="rounded-xl bg-mist p-4 text-sm font-bold text-ocean">Gestionar reservas</a><a href="/habitaciones" class="rounded-xl bg-mist p-4 text-sm font-bold text-ocean">Ver habitaciones</a><a href="/pagos" class="rounded-xl bg-mist p-4 text-sm font-bold text-ocean">Revisar pagos</a><a href="/reportes" class="rounded-xl bg-mist p-4 text-sm font-bold text-ocean">Abrir reportes</a></div></div></section><script src="../../scripts/dashboard.ts"></script></DashboardLayout>

