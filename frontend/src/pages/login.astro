---
import AuthLayout from '@/layouts/AuthLayout.astro';import Feedback from '@/components/ui/Feedback.astro';
---
<AuthLayout><div class="flex min-h-screen items-center justify-center bg-[linear-gradient(120deg,rgba(13,36,57,.95),rgba(13,36,57,.65)),url('https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1800&q=85')] bg-cover bg-center p-5"><form id="login-form" class="surface w-full max-w-md p-8 md:p-10"><a href="/" class="font-display text-xl tracking-wide text-gold">HOTEL GRAN CAPITAL</a><h1 class="mt-8 font-display text-4xl text-ink">Bienvenido</h1><p class="mt-2 text-sm text-slate-500">Accede a tu experiencia de hospedaje.</p><div id="form-error" class="mt-5"></div><label class="mt-6 block text-sm font-bold text-slate-600">Usuario o correo<input name="usuario" class="mt-2 w-full rounded-lg border border-slate-200 px-4 py-3 outline-none focus:border-ocean" required/></label><label class="mt-4 block text-sm font-bold text-slate-600">Contraseña<input name="contrasena" type="password" class="mt-2 w-full rounded-lg border border-slate-200 px-4 py-3 outline-none focus:border-ocean" required/></label><button class="mt-7 w-full rounded-lg bg-ocean px-4 py-3 font-bold text-white hover:bg-ink">Iniciar sesión</button><p class="mt-5 text-center text-sm text-slate-500">¿No tienes una cuenta? <a href="/registro" class="font-bold text-ocean hover:text-gold">Regístrate aquí</a></p><p class="mt-3 text-center text-xs text-slate-500">Hotel Gran Capital · Acceso seguro</p></form></div><script src="../scripts/login.ts"></script></AuthLayout>

