---
import DashboardLayout from '@/layouts/DashboardLayout.astro';import Guard from '@/components/layout/Guard.astro';import PageHeader from '@/components/ui/PageHeader.astro';import Button from '@/components/ui/Button.astro';
---
<DashboardLayout title="Clientes"><Guard/><PageHeader title="Clientes" description="Consulta y administra la información de los huéspedes"><Button slot="action" id="new-client">Nuevo cliente</Button></PageHeader><div id="client-feedback" class="mb-4 hidden rounded-lg p-3 text-sm"></div><div class="surface overflow-x-auto"><table class="w-full min-w-[700px] text-left text-sm"><thead class="border-b bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="p-4">Cliente</th><th class="p-4">Documento</th><th class="p-4">Correo</th><th class="p-4">Teléfono</th></tr></thead><tbody id="client-list"></tbody></table></div><div id="client-modal" class="fixed inset-0 z-20 hidden items-center justify-center bg-ink/60 p-5"><form id="client-form" class="surface w-full max-w-lg p-6"><h2 class="font-display text-2xl text-ink">Registrar cliente</h2><div class="mt-5 grid gap-4 sm:grid-cols-2"><label class="text-sm font-bold">Nombre<input name="nombre" class="field" required></label><label class="text-sm font-bold">Apellido<input name="apellido" class="field"></label><label class="text-sm font-bold">Documento<input name="documento" class="field" required></label><label class="text-sm font-bold">Teléfono<input name="telefono" class="field" required></label><label class="text-sm font-bold sm:col-span-2">Correo<input name="correo" type="email" class="field" required></label></div><div class="mt-5 flex gap-3"><button type="button" id="close-client" class="w-1/2 rounded-lg bg-mist py-3 font-bold text-ocean">Cancelar</button><button class="w-1/2 rounded-lg bg-ocean py-3 font-bold text-white">Guardar</button></div></form></div><script src="../../scripts/clients.ts"></script></DashboardLayout>

