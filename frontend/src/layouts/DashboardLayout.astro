---
import MainLayout from './MainLayout.astro';
const { title='Panel administrativo' }=Astro.props;
const items=[['/dashboard','◉','Dashboard','staff'],['/habitaciones','▣','Habitaciones','all'],['/clientes','♙','Clientes','staff'],['/reservas','◆','Reservas','all'],['/pagos','$','Pagos','staff'],['/servicios','✦','Servicios','all'],['/reportes','▰','Reportes','staff']];
---
<MainLayout title={`${title} · Hotel Gran Capital`}><div id="app-shell" class="min-h-screen bg-cream"><header class="flex h-[72px] items-center justify-between bg-ink px-5 text-white md:px-8"><a href="/" class="font-display text-xl tracking-wide text-gold">HOTEL GRAN CAPITAL</a><div class="flex items-center gap-3"><span id="session-name" class="hidden text-sm text-slate-200 sm:block"></span><button id="logout" class="rounded-lg px-3 py-2 text-sm text-white hover:bg-white/10">Cerrar sesión</button></div></header><div class="flex min-h-[calc(100vh-72px)]"><aside class="hidden w-64 shrink-0 border-r border-slate-200 bg-white p-4 md:block"><nav class="space-y-1">{items.map(([href,icon,label,scope])=><a href={href} data-scope={scope} class="nav-link flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-semibold text-slate-500 hover:bg-mist hover:text-ocean"><span class="text-lg">{icon}</span>{label}</a>)}</nav></aside><main class="w-full p-5 md:p-8"><div class="mb-5 flex gap-2 overflow-x-auto md:hidden">{items.map(([href,icon,label,scope])=><a href={href} data-scope={scope} class="nav-link whitespace-nowrap rounded-lg bg-white px-3 py-2 text-xs font-bold text-slate-500 shadow-sm">{icon} {label}</a>)}</div><slot /></main></div></div><script src="../scripts/shell.ts"></script></MainLayout>

